# Never put production secrets in this file.
MORVA_ENV=production
MORVA_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
MORVA_REQUIRE_MFA=true
MORVA_INTEGRATIONS_ENABLED=false
MORVA_ALLOW_DEMO_POLICIES=false
MORVA_REQUIRE_MIGRATED_SCHEMA=true
MORVA_MIGRATIONS_READY=false

# OIDC / JWT verification
MORVA_OIDC_ISSUER=https://<issuer>
MORVA_OIDC_AUDIENCE=morva-api
MORVA_OIDC_JWKS_URL=https://<issuer>/.well-known/jwks.json

# Managed versioned key rings. Inject through a secrets manager; never commit actual values.
# Keep retired versions during the approved retention window so existing ciphertext remains decryptable.
# Format: version:base64url-key[,version:base64url-key,...]
MORVA_FIELD_ENCRYPTION_KEYS=v1:<managed-32-byte-key>
MORVA_FIELD_LOOKUP_HMAC_KEYS=v1:<managed-32-byte-or-longer-key>
MORVA_KEY_VERSION=v1
MORVA_KEY_RETENTION_DAYS=90

# Legacy single-key variables are retained only for non-production compatibility.
MORVA_FIELD_ENCRYPTION_KEY=<managed-secret>
MORVA_FIELD_LOOKUP_HMAC_KEY=<managed-secret>

# Logging must never include national IDs, bank accounts or raw payroll rows.
MORVA_LOG_LEVEL=INFO
