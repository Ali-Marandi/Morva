{
  "name": "@asamuzakjp/css-color",
  "description": "CSS color - Resolve and convert CSS colors.",
  "author": "asamuzaK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asamuzaK/cssColor.git"
  },
  "homepage": "https://github.com/asamuzaK/cssColor#readme",
  "bugs": {
    "url": "https://github.com/asamuzaK/cssColor/issues"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@csstools/css-calc": "^3.3.0",
    "@csstools/css-color-parser": "^4.1.10",
    "@csstools/css-parser-algorithms": "^4.0.0",
    "@csstools/css-tokenizer": "^4.0.0",
    "lru-cache": "^11.5.2"
  },
  "devDependencies": {
    "@tanstack/vite-config": "^0.6.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-regexp": "^3.1.1",
    "globals": "^17.9.0",
    "knip": "^6.32.0",
    "mitata": "^1.0.34",
    "neostandard": "^0.13.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.34.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "oxc-resolver",
      "unrs-resolver"
    ],
    "overrides": {
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "lodash@>=4.0.0 <=4.17.23": ">=4.18.0",
      "minimatch@<3.1.4": ">=3.1.4"
    }
  },
  "scripts": {
    "bench:color": "npx tsx --expose-gc ./benchmark/bench-color.ts",
    "build": "pnpm run clean && pnpm run test && pnpm run knip && vite build && pnpm run publint",
    "clean": "rimraf ./coverage ./dist",
    "knip": "knip",
    "prettier": "prettier . --ignore-unknown --write",
    "publint": "publint --strict",
    "test": "pnpm run prettier && pnpm run --stream \"/^test:.*/\"",
    "test:eslint": "eslint ./src ./test --fix",
    "test:types": "tsc",
    "test:unit": "vitest"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "version": "6.0.7"
}
